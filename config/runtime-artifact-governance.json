{
  "schemaVersion": "bhm.runtime-artifact-governance.v1",
  "rules": [
    {
      "id": "authoritative-sqlite",
      "path": ".runtime/live-memory",
      "owner": "runtime",
      "class": "authoritative-storage",
      "disposition": "protected",
      "reason": "Active SQLite authority; never archive or delete while BHM is installed."
    },
    {
      "id": "qdrant-projection",
      "path": ".runtime/qdrant-local",
      "owner": "runtime",
      "class": "rebuildable-projection",
      "disposition": "protected",
      "reason": "Active local Qdrant projection; its recovery is a separate operational workflow."
    },
    {
      "id": "wl174-validation",
      "path": ".runtime/validation/wl-174",
      "owner": "WL-174/WL-175",
      "class": "validation-receipt",
      "disposition": "archive-review",
      "minimumRetentionDays": 90,
      "reason": "Staged sidecar reconciliation proof and rollback drill; retain through the current migration gate."
    }
  ]
}
