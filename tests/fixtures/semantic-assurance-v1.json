  "description": "Synthetic, redacted reference contract for deterministic semantic-assurance evaluation. It contains no live memory, credentials, runtime identifiers, or production facts.",
  "label_provenance": {
    "kind": "fixture_reference_contract",
    "independent_human_evidence": false,
    "claim": "Labels define expected evaluator behavior only. They are not independent human evidence and cannot establish universal model accuracy."
  },
  "labeling": {
    "kind": "fixture_reference_contract",
    "independent_human_evidence": false,
    "adjudication": "not_applicable_for_synthetic_fixture",
    "claim": "This dataset is a deterministic reference contract, not independently human-labeled evidence."
  },
  "model": {
    "selection": "provided_by_invoker",
    "load_or_replace_model": false,
    "note": "The evaluator must report the exact preloaded model identity supplied by its caller."
  },
  "prompt_contract": {
    "output_schema": "factuality, entailment, conflict, operation, support_relevance",
    "temperature": 0,
    "response_rule": "Return a safe classification only; do not execute or request lifecycle mutation."
  },
  "evaluation_boundary": {
    "proposal_only": true,
    "sqlite_mutation": false,
    "mem0_mutation": false,
    "qdrant_mutation": false,
    "automatic_apply": false,
    "unsafe_or_unsupported_operation": "no_op"
  },
  "split_contract": {
    "partitions": [
      "development",
      "validation",
      "sealed_holdout"
    ],
    "group_isolation": "A family_id, group_id, source_theme, prompt_template, and paraphrase cluster must occur in exactly one partition.",
    "labels_excluded_from_model_input": true,
    "sealed_holdout_usage": "Do not tune prompt, policy, thresholds, or fixture labels after observing this partition."
  },
  "splits": {
    "development": {
      "purpose": "mechanics and prompt development only"
    },
    "validation": {
      "purpose": "threshold validation without cross-partition family leakage"
    },
    "sealed_holdout": {
      "purpose": "final untouched measurement; no tuning after observation"
    }
  },
  "quality_gate": {
    "unsafe_non_no_op_budget": 0,
    "conflict_recall_required": 1.0,
